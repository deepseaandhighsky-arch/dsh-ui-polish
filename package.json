{
  "name": "dsh-ui-polish",
  "version": "0.4.1",
  "description": "dsh 原生 UI 设计优化插件：在 dsh 本土设计语言之上做观感与交互打磨（双层阴影、28px 七档渐隐、状态光晕、排版光学、四档弹簧、可选合成音效），并泛用适配第三方插件界面；不改变框架与品牌视觉。",
  "license": "MIT",
  "author": "deepseaandhighsky-arch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseaandhighsky-arch/dsh-ui-polish.git"
  },
  "homepage": "https://github.com/deepseaandhighsky-arch/dsh-ui-polish",
  "bugs": {
    "url": "https://github.com/deepseaandhighsky-arch/dsh-ui-polish/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "polish"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown && node -e \"require('fs').renameSync('lib/client.iife.js','lib/client.js')\"",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.14.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
